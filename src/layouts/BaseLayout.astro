---
import "@/styles/global.css";
import { Font } from "astro:assets";
import { UserMenu } from "@/components/UserMenu";
import HeaderWeather from "@/components/HeaderWeather.astro";
import { SITE_DESCRIPTION, SITE_NAME } from "@/consts.ts";

interface Props {
  /** Page title. The site name is appended. */
  title?: string;
  /** Page description. Defaults to `SITE_DESCRIPTION`. */
  description?: string;
  /** Show the top bar with the site name and menu. */
  header?: boolean;
}

const { title, description = SITE_DESCRIPTION, header = true } = Astro.props;
const { session } = Astro.locals;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title ? `${title} | ${SITE_NAME}` : SITE_NAME}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#fff9fb" />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist-pixel" preload />
  </head>
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-card focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    {/* The blur is on ::before: backdrop-filter on the header would trap the fixed menu button inside it */}
    {header && (
      <header class="sticky top-0 z-40 isolate before:absolute before:inset-0 before:-z-10 before:bg-background/40 before:backdrop-blur pr-[max(1.5rem,env(safe-area-inset-right))] pl-[max(1.5rem,env(safe-area-inset-left))]">
        <div class="mx-auto grid h-16 max-w-[100ch] grid-cols-[auto_1fr_auto] content-center items-baseline gap-4 sm:grid-cols-[1fr_auto_1fr]">
          <a
            href="/"
            class="flex items-center font-pixel gap-2 justify-self-start text-lg font-medium transition-opacity hover:opacity-60 whitespace-nowrap"
          >
            <img
              src="/favicon.svg"
              alt=""
              width="24"
              height="24"
              class="size-6"
            />
            {SITE_NAME}
          </a>
          <div class="justify-self-end sm:justify-self-auto">
            {session && <HeaderWeather server:defer />}
          </div>
          <div class="justify-self-end max-sm:fixed max-sm:right-[max(1rem,env(safe-area-inset-right))] max-sm:bottom-[calc(1rem+env(safe-area-inset-bottom))] max-sm:z-50">
            {session && <UserMenu client:load name={session.name} />}
          </div>
        </div>
      </header>
    )}
    <main
      id="main"
      tabindex="-1"
      class="flex-1 pr-[max(1.5rem,env(safe-area-inset-right))] pl-[max(1.5rem,env(safe-area-inset-left))] outline-none"
    >
      <div class="mx-auto max-w-[100ch]">
        <slot />
      </div>
    </main>
    <script>
      if ("serviceWorker" in navigator)
        navigator.serviceWorker.register("/sw.js");
    </script>
  </body>
</html>
