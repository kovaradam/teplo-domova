---
import Layout from "@/layouts/BaseLayout.astro";
import LoginForm from "@/components/LoginForm.astro";
import { login } from "@/lib/cozytouch.ts";
import { startSession } from "@/lib/session.ts";
import { SITE_NAME } from "@/consts.ts";

let email = "";
let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = String(form.get("email") ?? "");
  try {
    startSession(
      Astro.cookies,
      await login(email, String(form.get("password") ?? "")),
    );
    return Astro.redirect("/", 303);
  } catch (e) {
    console.error("POST /login:", e);
    error = (e as Error).message;
  }
}
---

<Layout title="Log in" header={false}>
  <section class="mx-auto flex w-full max-w-sm flex-col gap-6 py-16">
    <div class="flex flex-col gap-1">
      <h1 class="flex items-center gap-2.5 text-2xl font-medium tracking-tight whitespace-nowrap">
        <img src="/favicon.svg" alt="" width="28" height="28" class="size-7" />
        <span class="font-pixel">{SITE_NAME}</span>
      </h1>
      <p class="text-sm text-muted-foreground">Use your Cozytouch account.</p>
    </div>
    <LoginForm email={email} error={error} />
  </section>
</Layout>
