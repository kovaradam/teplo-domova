---
import Layout from "@/layouts/BaseLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { SITE_NAME } from "@/consts.ts";
---

<Layout title="Offline" header={false}>
  <section class="mx-auto flex max-w-sm flex-col items-center gap-4 py-24 text-center">
    <img src="/favicon.svg" alt="" width="48" height="48" class="size-12" />
    <h1 class="font-pixel text-2xl">{SITE_NAME}</h1>
    <p class="text-muted-foreground">
      You're offline. Your heaters can't be reached without a connection.
    </p>
    <a href="/" class={buttonVariants({ size: "lg", className: "mt-2 h-10 px-5" })}>
      Try again
    </a>
  </section>
</Layout>
